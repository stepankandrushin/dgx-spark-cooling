[Unit]
Description=Hold a 9000 RPM minimum on the Spark's fans
After=nvidia-persistenced.service systemd-modules-load.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/spark-fan set 66
ExecStop=/usr/local/sbin/spark-fan auto
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
